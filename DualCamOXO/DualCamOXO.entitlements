<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push (OneSignal). `production` même en Debug : l'environnement APNs réel est choisi par
	  le profil de provisionnement, et une valeur `development` dans un build distribué donne
	  un jeton que le serveur APNs refuse en silence.
	-->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
